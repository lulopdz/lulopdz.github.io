---
// src/layouts/Layout.astro
// Home-page chrome (two-column sidebar + tabbed content area) on top of BaseLayout.
import { getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import TabsHeader from '../components/TabsHeader.astro';
import profile from '../assets/profile.jpg';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Luis Lopez | Carleton University",
  description = "Luis Lopez - PhD Candidate in Power & Energy Systems Planning at Carleton University (Apex Lab)."
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://lulopdz.github.io');

// Portrait for the Person schema (a plain headshot works better than the OG card here)
const portrait = await getImage({ src: profile, width: 800, format: 'jpeg', quality: 80 });
const portraitUrl = new URL(portrait.src, siteUrl);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#person', siteUrl).href,
  name: 'Luis Lopez',
  givenName: 'Luis',
  familyName: 'Lopez',
  jobTitle: 'PhD Candidate',
  description: 'PhD Candidate in power and energy systems planning at the Apex Lab, Carleton University.',
  url: siteUrl.href,
  image: portraitUrl.href,
  email: 'mailto:luislopezdiaz@cmail.carleton.ca',
  affiliation: {
    '@type': 'Organization',
    name: 'Carleton University',
    url: 'https://carleton.ca/',
    department: {
      '@type': 'Organization',
      name: 'Apex Lab',
      url: 'https://carleton.ca/apex/',
    },
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidad del Norte',
    url: 'https://www.uninorte.edu.co/',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ottawa',
    addressRegion: 'ON',
    addressCountry: 'CA',
  },
  knowsAbout: ['Power and energy systems planning', 'Electricity markets', 'Grid operations', 'Optimization'],
  sameAs: [
    'https://scholar.google.com/citations?user=Lg3HTnMAAAAJ&hl=en',
    'https://www.researchgate.net/profile/Luis-Lopez-Diaz',
    'https://github.com/lulopdz',
  ],
};
---

<BaseLayout title={title} description={description} ogType="profile">
  <Fragment slot="head">
    <!-- Structured data: schema.org Person -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </Fragment>

  <div class="site-wrapper">
    <Sidebar />

    <main class="content-area">
      <TabsHeader />

      <slot />

      <footer class="site-footer">
        <p>&copy; {new Date().getFullYear()} Luis Lopez &bull; Carleton University &bull; Hosted on GitHub Pages</p>
      </footer>
    </main>
  </div>
</BaseLayout>
