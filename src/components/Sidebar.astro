---
// src/components/Sidebar.astro
---

<aside class="sidebar">
  <div class="avatar-container">
    <img src="assets/images/profile.jpg" alt="Luis Lopez Diaz" class="avatar-img" width="220" height="148" />
  </div>

  <h1 class="sidebar-name">Luis Lopez-Diaz</h1>
  <p class="sidebar-role">PhD Candidate</p>
  
  <p class="sidebar-affil">
    <a href="https://carleton.ca/apex/" target="_blank" rel="noopener">Apex Lab</a><br />
    <a href="https://carleton.ca/" target="_blank" rel="noopener">Carleton University</a>
  </p>

  <!-- Minimalist Social Icons -->
  <div class="sidebar-icons">
    <a href="https://drive.google.com/file/d/1zNwCbKcJ81FQDHWTxkNmvkMf4N3kPkV4/view" target="_blank" rel="noopener" class="icon-link cv-text" title="Curriculum Vitae">
      CV
    </a>
    <a href="https://scholar.google.com/citations?user=Lg3HTnMAAAAJ&hl=en" target="_blank" rel="noopener" class="icon-link" title="Google Scholar">
      <i class="ai ai-google-scholar"></i>
    </a>
    <a href="https://www.researchgate.net/profile/Luis-Lopez-Diaz" target="_blank" rel="noopener" class="icon-link" title="ResearchGate">
      <i class="ai ai-researchgate"></i>
    </a>
    <a href="https://github.com/lulopdz" target="_blank" rel="noopener" class="icon-link" title="GitHub">
      <i class="fab fa-github"></i>
    </a>
    <a href="mailto:luislopezdiaz@cmail.carleton.ca" class="icon-link" title="Email">
      <i class="fas fa-envelope"></i>
    </a>
  </div>

  <!-- Location -->
  <div class="sidebar-meta">
    <div class="meta-location">
      <i class="fas fa-map-marker-alt"></i> Ottawa, ON, Canada
    </div>
  </div>
</aside>

