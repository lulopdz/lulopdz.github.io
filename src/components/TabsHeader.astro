---
// src/components/TabsHeader.astro
import ThemeToggle from './ThemeToggle.astro';
---

<header class="tabs-header">
  <div class="active-tab-title">
    <h2 class="tab-title-text" id="current-tab-title">About</h2>
    <div class="gradient-bar"></div>
  </div>

  <nav class="tabs-nav">
    <button class="tab-btn active" data-tab="tab-about">About</button>
    <button class="tab-btn" data-tab="tab-papers">Papers</button>
    <button class="tab-btn" data-tab="tab-teaching">Teaching</button>
    <button class="tab-btn" data-tab="tab-tools">Tools</button>
    <button class="tab-btn" data-tab="tab-contact">Contact</button>

    <ThemeToggle />
  </nav>
</header>
